# Copy to apps/api/.env and replace placeholders using Supabase's Connect panel.
# Runtime: Supavisor transaction pooler (port 6543).
# Percent-encode special characters in the password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"

# Prisma CLI: direct connection (requires IPv6 or the Supabase IPv4 add-on).
# On IPv4-only networks use the session pooler URL (port 5432) from Connect.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
